# Optional server-side credentials. Leave empty to use keys entered in the UI.
# Never prefix these names with NEXT_PUBLIC_ and never commit real credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AIHUBMIX_API_KEY=
TYPESAFE_API_KEY=

# Compatibility aliases, used only when the primary name above is absent:
# GOOGLE_API_KEY=
# JEV_API_KEY=

# Models, protocols, and base URLs are configured in the app's model settings.
# Server keys are used only for matching official API base URLs.
# AIHUBMIX_API_KEY is separate from OPENAI_API_KEY and is used only with
# https://aihubmix.com/v1. The official backup https://api.inferera.com/v1
# requires an explicitly entered Key in that connection.
